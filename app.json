{
  "expo": {
    "name": "Pøs",
    "slug": "pos-app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/rain-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amundfremming.posapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2F0EA",
        "foregroundImage": "./assets/rain-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/rain-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/rain-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F2F0EA"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cca612f2-cf08-43f2-b160-ea485b24e562"
      }
    },
    "owner": "amundfremming"
  }
}
